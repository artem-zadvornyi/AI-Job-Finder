# Required — create your bot via @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Optional — Telegram user id for /stats (get from @userinfobot)
ADMIN_USER_ID=123456789

# development | production (default: development)
# production → INFO logs; development → DEBUG logs
ENVIRONMENT=development

# HTTP health server port (Railway/Render set PORT automatically)
PORT=8000

# Optional — PostgreSQL (Railway/Render provide DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — SQLite when DATABASE_URL is not set
# SQLITE_URL=sqlite+aiosqlite:///./job_finder_bot.db
# Docker Compose uses: sqlite+aiosqlite:////app/data/job_finder_bot.db

# Optional — alert check interval in seconds (default 1800 = 30 min; min 30)
# ALERTS_INTERVAL_SECONDS=60
